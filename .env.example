# Local settings and secrets. Copy this file to .env in the same folder (the repo root) and fill
# in the blanks; see "Create your .env file" in the README. .env is gitignored: never commit it.
# docker compose and the backend both read .env automatically.
#
# To generate a random secret, paste this into PowerShell and copy the output:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)

# --- Database -----------------------------------------------------------------
DB_USER=BrainFeed
# Required. Paste a generated secret. This only sets the password when the database is first
# created; to change it later, run `docker compose down -v` (deletes local data).
DB_PASSWORD=
# Only used when running the backend outside Docker. Inside Docker, docker-compose.yml overrides it
# to point at the "db" container.
DB_URL=jdbc:postgresql://localhost:5432/brainfeed

# --- Password hashing -----------------------------------------------------------
# Required. Paste a generated secret (a different one than DB_PASSWORD).
# A secret key mixed into every password hash. It is NOT stored in the database, so a stolen
# database alone can't be cracked. Losing or changing it makes every existing account's password
# stop working, so in production it must be kept safe and never changed.
# For local development each person can generate their own.
PASSWORD_PEPPER=
# Checks new passwords against the Have I Been Pwned breach list. Only the first 5 characters
# of the password's SHA-1 hash are sent. Set to false only if you're working offline.
PASSWORD_BREACH_CHECK=true

# --- Web ------------------------------------------------------------------------
# Leave false for local development (plain http). Must be true in production (https).
COOKIE_SECURE=false
# Comma-separated URLs the frontend is served from, as shown in the browser's address bar.
ALLOWED_ORIGINS=http://localhost:5173
# Port the backend listens on. Leave it at 7070: docker-compose.yml and frontend/vite.config.ts
# both expect it.
PORT=7070
